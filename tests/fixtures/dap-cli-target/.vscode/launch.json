      },
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/bin/windows-runtime.exe"
      }
    },
    {
      "type": "fakeFixtureLaunchA",
      "request": "launch",
      "name": "Fixture Launch A",
      "program": "${workspaceFolder}/index.js",
