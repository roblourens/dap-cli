!tests/fixtures/**/dist/
!tests/fixtures/**/dist/**

# Runtime logs and diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and local machine state
.env
.env.*
!.env.example
.DS_Store

# Temporary files
tmp/
temp/
.cache/

# Adapter/debug session artifacts
.dap-cli/
*.pid
*.sock

# Hand-driven Playwright + dap-cli demo artifacts
.playwright-cli/
test-results/
.demo-chrome-profile/